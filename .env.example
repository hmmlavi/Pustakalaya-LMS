# Pustakalaya Local Configuration Example
# Copy this file to .env and set a strong random SECRET_KEY before running.

FLASK_ENV=development
SECRET_KEY=replace-with-a-random-64-hex-character-secret-key
DATABASE_URL=sqlite:///instance/pustakalaya.db
LIBRARY_TIMEZONE=Asia/Kolkata
SESSION_LIFETIME_MINUTES=480
PICKUP_HOLD_DAYS=3
SEED_RANDOM_SEED=20261024
HISTORICAL_REFERENCE_DATE=2026-10-24
HISTORICAL_DAYS=365
HOST=127.0.0.1
PORT=5000

# Optional writable application-data directory for packaged/installed deployments.
# PUSTAKALAYA_DATA_DIR=%LOCALAPPDATA%\\Pustakalaya

# Optional: only read by scripts/initialize_db.py when bootstrapping an initial admin
# Do NOT commit real credentials to version control.
# PUSTAKALAYA_ADMIN_USERNAME=admin
# PUSTAKALAYA_ADMIN_PASSWORD=
# PUSTAKALAYA_ADMIN_FULL_NAME=Chief Librarian
